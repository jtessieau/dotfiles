[init]
    defaultBranch = main

[core]
    autocrlf = input
    whitespace = trailing-space,space-before-tab

[color]
    ui = auto

[push]
    default = simple
    autoSetupRemote = true
    followTags = true

[pull]
    rebase = false

[fetch]
    prune = true
    pruneTags = true
    fsckObjects = true

[merge]
    conflictStyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = zebra

[rerere]
    enabled = true
    autoUpdate = true

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[help]
    autocorrect = prompt

[commit]
    verbose = true

[status]
    showUntrackedFiles = all
    submoduleSummary = true

[alias]
    # Shortcuts
    st = status
    sw = switch
    br = branch
    ci = commit

    # Status / branches
    s = status -sb
    branches = branch -a
    recent = branch --sort=-committerdate

    # Commits / history
    last = log -1 HEAD
    lg = log --oneline --graph --decorate --all
    ll = log --pretty=oneline --abbrev-commit
    history = log --graph --pretty=format:'%C(auto)%h%d %s %C(white)- %an, %ar%Creset' --all

    # Changes
    unstage = restore --staged
    discard = restore
    changes = diff
    staged = diff --staged

    # Useful operations
    amend = commit --amend

    # Remote
    remotes = remote -v

    # Cleanup
    gone = "!f() { git fetch --prune || return; git branch -vv | awk '/: gone]/{print $1}' | while IFS= read -r branch; do git branch -d \"$branch\"; done; }; f"

    # Show current branch
    current = branch --show-current

    # Find a commit
    find = log --all --oneline --decorate --grep

    # Show files changed in last commit
    last-files = diff-tree --no-commit-id --name-only -r HEAD

# Optional per-machine overrides (for example, a work identity or signing key).
# Git ignores this include when the file does not exist.
[include]
    path = ~/.gitconfig.local
